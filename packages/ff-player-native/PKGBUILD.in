# Generated by prepare.py with a complete, hashed source/dependency bundle.
# Local build only. No upload, repository signing or service activation hooks.
pkgname=ff-player-native
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native FFOS artwork host with a public Chromium engine and native image/media playback'
arch=('x86_64')
license=('custom')
depends=('glibc' 'gcc-libs' 'sqlite' 'sdl2-compat' 'glycin>=2.1' 'libheif' 'libglvnd' 'mesa'
         'pango' 'qrencode' 'nss' 'alsa-lib' 'libcups' 'at-spi2-core' 'libx11'
         'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxrandr' 'libxkbcommon'
         'dav1d>=1.5.3' 'libass' 'lcms2' 'libpulse' 'gnutls' 'libva' 'zlib' 'libjpeg-turbo' 'curl' 'libdisplay-info'
         'bubblewrap' 'ca-certificates' 'ttf-dejavu' 'python' 'wayland>=1.24' 'libdrm>=2.4.129' 'grim' 'wlr-randr')
makedepends=('gcc=16.1.1+r346+g4e03491b401d-3' 'cmake=4.4.0-1'
             'ninja=1.13.2-3' 'meson=1.11.2-1' 'pkgconf=2.5.1-1'
             'nasm=3.02-1' 'make=4.4.1-3' 'python-jinja' 'wayland-protocols')
options=('debug' 'strip' '!lto')
source=('ff-player-native-source.tar.gz')
sha256sums=('@SOURCE_SHA256@')

prepare() {
  cd "$srcdir/ff-player-native"
  # The bundle contains every declared archive. This check must never fetch
  # dependencies from the network in makepkg's build/check/package phases.
  python3 tools/verify-vendor.py --without-cef
  python3 tools/prepare-renderers.py
}

build() {
  cd "$srcdir/ff-player-native"
  export FF_BUILD_JOBS=3
  sh tools/build-presentation.sh
  export PKG_CONFIG_PATH="$srcdir/ff-player-native/build-presentation/prefix/lib/pkgconfig:$srcdir/ff-player-native/build-presentation/prefix/share/pkgconfig"
  sh tools/build-ffmpeg.sh
  sh tools/build-media.sh
  export PKG_CONFIG_PATH="$srcdir/ff-player-native/build-media/prefix/lib/pkgconfig:$srcdir/ff-player-native/build-presentation/prefix/lib/pkgconfig:$srcdir/ff-player-native/build-presentation/prefix/share/pkgconfig"
  cmake -S . -B build -G Ninja -DFF_WITH_PUBLIC=ON -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build -j3
}

check() {
  cd "$srcdir/ff-player-native"
  LD_LIBRARY_PATH="$srcdir/ff-player-native/build-media/prefix/lib:$srcdir/ff-player-native/build-presentation/prefix/lib" \
    ctest --test-dir build --output-on-failure
  python3 protocol/generate-schema.py --check
}

package() {
  cd "$srcdir/ff-player-native"
  DESTDIR="$pkgdir" cmake --install build
  install -dm755 "$pkgdir/usr/bin"
  ln -s /usr/lib/ff-player-native/ff-player-native "$pkgdir/usr/bin/ff-player-native"
  chmod 4755 "$pkgdir/usr/lib/ff-player-native/engine/chrome_sandbox"
  install -Dm644 source-manifest.json "$pkgdir/usr/share/ff-player-native/source-manifest.json"
  install -Dm644 README.md "$pkgdir/usr/share/doc/ff-player-native/README.md"
  install -Dm644 docs/MIGRATION.md "$pkgdir/usr/share/doc/ff-player-native/MIGRATION.md"
  install -Dm644 docs/MEDIA.md "$pkgdir/usr/share/doc/ff-player-native/MEDIA.md"
  # The JSON header carries its complete MIT notice.
  install -Dm644 vendor/json.hpp "$pkgdir/usr/share/licenses/ff-player-native/nlohmann-json.hpp"
}
