# System
base
sudo
nano
curl
parted
dosfstools
rsync
openssl
openssh
reflector
# LTS kernel (6.18 series); boot artifacts keep the legacy vmlinuz-linux /
# initramfs-linux.img names required by fleet OTA scripts and ESP boot entries
# (see etc/pacman.d/hooks/60-linux-lts-kernel-compat.hook and
# etc/mkinitcpio.d/linux-lts.preset)
linux-lts
# Rebuilt amdgpu.ko (installed under updates/, wins in depmod search order)
# with the VCN 3.1.1 H.264 decode cap at 4096x4080: the firmware returns an
# unwritten green surface at 4096x4096 and the stock kernel table advertises
# it (ffos-user#302). Pinned to the exact linux-lts above; a snapshot bump
# that moves the kernel fails this image build until the package is re-based
# (see packages/amdgpu-vcn-h264-cap/README.md).
amdgpu-vcn-h264-cap
# Firmware trimmed for FF1 hardware only (AMD Ryzen 7 7735U SoC + Realtek Wi-Fi/BT)
linux-firmware-amdgpu
linux-firmware-realtek
mkinitcpio
mkinitcpio-archiso
arch-install-scripts
polkit
jq
p7zip
btrfs-progs
dmidecode
tpm2-tools
# mesa provides libva-mesa-driver (radeonsi VAAPI) for Chromium hardware video
# decode on the AMD iGPU; no separate VA driver package is needed
mesa
vulkan-radeon
ethtool
ddcutil

# Boot support
# amd-ucode.img is also copied to intel-ucode.img at build time for legacy
# OTA filename compatibility (see airootfs/etc/pacman.d/hooks)
amd-ucode

# Networking core
networkmanager
# dnsmasq backs NetworkManager's shared ("hotspot") mode: NM spawns its own
# dnsmasq instance to serve DHCP/DNS for the SoftAP provisioning network that
# feral-controld brings up. Without it, `nmcli`/NM shared-mode activation fails.
dnsmasq
# nftables carries the captive-portal DNAT (/etc/nftables.conf): hotspot DNS
# answers 192.0.2.1 (Samsung rejects private-IP probe answers) and this
# redirects 192.0.2.1:80/443 back to the local portal.
nftables

# Wayland & Kiosk mode
wayland
cage
wlroots0.18
xorg-xwayland
chromium
wlr-randr
seatd

# Fonts and themes
ttf-dejavu
ttf-liberation
noto-fonts-cjk
adwaita-icon-theme

# Audio and Bluetooth
# bluez and pulseaudio-bluetooth are intentionally KEPT after the SoftAP/setupd
# merge removed BLE provisioning: they now serve Bluetooth AUDIO only. Auditing
# whether the BT stack can be trimmed further is a separate follow-up ticket.
bluez
pulseaudio
pulseaudio-bluetooth
pamixer

# Debug / Monitoring
lm_sensors
earlyoom

# Feralfile
# feral-setupd (the Rust BLE provisioning daemon) is removed: feral-controld now
# absorbs provisioning via a NetworkManager SoftAP hotspot + captive portal.
feral-controld
feral-sys-monitord
feral-watchdog
feral-player

# HTTP server to serve feral-player static
darkhttpd