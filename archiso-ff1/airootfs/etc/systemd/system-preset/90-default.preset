enable bluetooth.service
enable NetworkManager.service
enable btrfs-subvolume-manager.service
enable earlyoom.service
# NTP is now the device's only wall-clock source after BLE `set_time` was
# removed with the setupd merge; enable timesyncd so the pinned servers in
# timesyncd.conf.d/10-ntp-servers.conf actually take effect.
enable systemd-timesyncd.service
