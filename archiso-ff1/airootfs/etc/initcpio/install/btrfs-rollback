#!/bin/bash

build() {
    add_runscript
    # The power-cycle factory-reset gesture (issue #122) arms the one-shot
    # loader menu from the initramfs: bootctl writes LoaderEntryOneShot /
    # LoaderConfigTimeoutOneShot, which needs efivarfs mounted. add_binary
    # resolves bootctl's shared-library deps; add_module is a no-op when
    # efivarfs is built into the kernel.
    add_binary bootctl
    add_module efivarfs
}

help() {
    cat <<HELPEOF
This hook allows rollback via btrfs subvolumes, and implements the
power-cycle factory-reset gesture (5 unclean power cuts -> one-shot
factory_reset.conf boot with an on-screen countdown).
HELPEOF
}